# Backend environment variables (example)
# Copy this to .env and fill in secure values before running the server.

# App
NODE_ENV=development
PORT=3000

# Database (Postgres)
# Either a full DATABASE_URL or individual settings below
DATABASE_URL=postgres://user:password@localhost:5432/inventory_db
# Or:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=inventory_db
PG_USER=postgres
PG_PASSWORD=postgres

# JWT / Tokens
ACCESS_TOKEN_SECRET=replace_with_strong_random_string
REFRESH_TOKEN_SECRET=replace_with_strong_random_string
ACCESS_TOKEN_TTL=15m
# Integer days for refresh token TTL (used by auth.service.js)
REFRESH_TOKEN_TTL_DAYS=30

# Session inactivity timeout (minutes)
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Agoo SMS
AGOOSMS_API_URL=https://api.agoosms.com/v1/sms/send
AGOOSMS_API_KEY=agoo_live_xxx
AGOOSMS_SENDER_ID=MyStore

# Queue worker
QUEUE_WORKER_INTERVAL_MS=30000
QUEUE_MAX_RETRIES=5

# Redis cache
REDIS_URL=redis://127.0.0.1:6379
REPORT_CACHE_TTL=300

# Other
# Use true in production behind HTTPS
COOKIE_SECURE=false

# Notes:
# - Use `AGOOSMS_API_URL` with Agoo SMS send endpoint and set `X-API-Key` via `AGOOSMS_API_KEY`.
# - `AGOOSMS_SENDER_ID` should be your approved Agoo sender ID.
# - For test keys, Agoo may require a fixed test senderId and/or message content.
# - Start the worker with `npm run queue:worker`.
# - Admin SMS test endpoint: POST /api/v1/admin/sms/test { "to": "+233...", "message": "Hello" }
