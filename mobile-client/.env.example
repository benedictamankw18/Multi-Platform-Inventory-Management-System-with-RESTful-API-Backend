# MPIMS mobile client environment
#
# Copy this file to `.env.local` and set the base URL of the REST API,
# including the `/api/v1` prefix.
#
# Android emulator : http://10.0.2.2:8040/api/v1
# iOS simulator    : http://localhost:8040/api/v1
# Physical device  : http://<your-computer-LAN-IP>:8040/api/v1
#
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
# NEVER put real secrets (passwords, private keys, service tokens) in these
# files — anything prefixed with EXPO_PUBLIC_ is embedded in the client.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8040/api/v1
