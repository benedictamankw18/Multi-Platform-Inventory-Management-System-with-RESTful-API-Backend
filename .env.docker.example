# Docker Compose environment for the production stack.
#
#   cp .env.docker.example .env
#
# Then replace every "change_me" value with a fresh secret. Do NOT reuse the
# credentials from backend/.env. Generate JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# --- PostgreSQL ---
# POSTGRES_USER must stay "postgres": the schema dump assigns objects to it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=multiplatforminventorysystem

# --- Initial administrator (created once, on first database init) ---
# Set a strong password; you can change it after logging in. Leaving
# SEED_ADMIN_PASSWORD blank skips admin creation entirely.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_ADMIN_EMAIL=admin@example.com
SEED_BRANCH_NAME=Main Branch

# --- Auth / JWT ---
ACCESS_TOKEN_SECRET=change_me_access_token_secret
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# Set true only when serving over HTTPS (secure cookies).
COOKIE_SECURE=false

# --- Queue worker ---
QUEUE_WORKER_INTERVAL_MS=30000
QUEUE_MAX_RETRIES=5

# --- SMS provider (optional; leave blank to disable) ---
AGOOSMS_API_URL=
AGOOSMS_API_KEY=
AGOOSMS_SENDER_ID=

# --- E-mail / SMTP (optional; leave Email_HOST blank to disable sending) ---
# When Email_HOST is blank the API/worker log messages instead of sending them.
# Port 587 = STARTTLS (Email_SECURE=false); port 465 = implicit TLS (Email_SECURE=true).
Email_HOST=
Email_PORT=587
Email_USER=
Email_PASSWORD=
Email_SECURE=false
# Public base URL used to build password-reset links.
APP_URL=http://localhost

# --- Local dev mail catcher (optional) ---
# Start it with:  docker compose --profile mail up -d   (web UI: http://localhost:8025)
# Then set Email_HOST=mailpit and Email_PORT=1025 above to route mail into it.

# --- Host ports ---
# WEB_PORT is where the app is reached; API_PORT is for direct API access.
# If port 80 is in use or reserved by the OS, use another (e.g. 8080).
WEB_PORT=80
API_PORT=8040
